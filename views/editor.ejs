<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Editor Dashboard | Fakest News</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <main>
        <h1>Editor Dashboard</h1>

        <section id="articles-section">
            <h2>Articles</h2>

            <div id="article-filters">
                <label for="status-filter">Filter by status:</label>

                <select id="status-filter">
                    <option value="all">All</option>
                    <option value="pending" selected>Pending approval</option>
                    <option value="returned">Returned for corrections</option>
                    <option value="published">Published</option>
                </select>
            </div>

            <div id="articles-container">
                <p>Loading articles...</p>
            </div>
        </section>

        <section id="review-section">
            <h2>Article Review</h2>

            <div id="review-container">
                <p>Select an article to review it.</p>
            </div>
        </section>

        <section id="analytics-section">
            <h2>Article Analytics</h2>

            <div id="analytics-container">
                <p id="analytics-message">
                    Select an article to view its analytics.
                </p>

                <div id="chart-container" hidden>
                    <canvas id="views-chart"></canvas>

                    <div id="update-comparison"></div>
                </div>
            </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/editor.js"></script>
</body>

</html>