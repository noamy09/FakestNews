<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= article.title %> - Fakest News</title>
  <meta name="description" content="<%= article.summary || article.title %>">
  <meta name="author" content="<%= article.author ? (article.author.name || article.author.username) : 'Staff' %>">
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📰</text></svg>">
</head>
<body>
  <header class="site-header">
    <div class="header-container"><a href="/" class="brand-link">📰 Fakest News</a></div>
  </header>

  <main class="single-article-container">
    <article class="full-article">
      <header class="article-header">
        <span class="badge"><%= article.category %></span>
        <h1><%= article.title %></h1>
        <div class="meta-row">
          <span>By <strong><%= article.author ? (article.author.name || article.author.username) : 'Staff' %></strong></span>
          <span>Published on <%= new Date(article.createdAt).toLocaleDateString('en-US') %></span>
          <span>Views: <%= article.views || 1 %></span>
        </div>
      </header>

      <% if (article.imageUrl) { %>
        <figure class="featured-media">
          <img src="<%= article.imageUrl %>" alt="<%= article.title %>">
        </figure>
      <% } %>

      <div class="article-body">
        <%- article.content %>
      </div>
    </article>
  </main>

  <script>
    (function() {
      const articleId = "<%= article._id %>";
      const readArticles = JSON.parse(localStorage.getItem("fakest_news_read") || "[]");
      if (!readArticles.includes(articleId)) {
        readArticles.push(articleId);
        localStorage.setItem("fakest_news_read", JSON.stringify(readArticles));
      }
    })();
  </script>
</body>
</html>