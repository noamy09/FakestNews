<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Page title -->
  <title>Fakest News - Login</title>
  <!-- Global and login page stylesheets -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📰</text></svg>">
</head>
<body>
  <!-- Simplified site header -->
  <header class="site-header">
    <div class="header-container">
      <a href="/" class="brand-link">📰 Fakest News</a>
    </div>
  </header>

  <!-- Login view wrapper -->
  <main class="feed-wrapper">
    <div class="auth-container">
      <!-- Welcome header text -->
      <div class="auth-header">
        <h1>Welcome!</h1>
        <p>Login to access your Hub workspace</p>
      </div>

      <!-- Error message container -->
      <div id="login-error" class="error-alert"></div>

      <!-- Authentication form -->
      <form id="login-form">
        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" placeholder="editor@fakestnews.com" required>
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required>
        </div>

        <!-- Submit button -->
        <button type="submit" class="auth-submit-btn" id="submit-btn">Login</button>
      </form>

      <!-- Account assistance notice -->
      <div class="auth-footer">
        Need an account? Contact your site administrator.
      </div>
    </div>
  </main>

  <!-- Client-side authentication handler -->
  <script>
    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const errorDiv = document.getElementById('login-error');
      const submitBtn = document.getElementById('submit-btn');
      
      // Reset alert state and show pending label
      errorDiv.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Logging in...';

      // Read form input values
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;

      try {
        // Send login POST request to authentication endpoint
        const res = await fetch('/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ email, password })
        });

        const data = await res.json();

        // Handle unsuccessful login responses
        if (!res.ok) {
          throw new Error(data.message || 'Login failed. Please check your credentials.');
        }

        // Redirect on successful login
        window.location.href = '/';
      } catch (err) {
        // Render failure message
        errorDiv.textContent = err.message;
        errorDiv.style.display = 'block';
      } finally {
        // Restore button state
        submitBtn.disabled = false;
        submitBtn.textContent = 'Login';
      }
    });
  </script>
</body>
</html>